# ============================================================
# WorkNexus - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
#
# The .env file is gitignored - it is NEVER committed.
# A small loader in index.php reads this file before
# CodeIgniter boots and exposes every value to getenv().
#
# Real environment variables (web server SetEnv / fastcgi_param
# / system env) always override values from this file.
# ============================================================

# ------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------
# CI_ENV=development

# ------------------------------------------------------------
# Base URL
# ------------------------------------------------------------
# WN_BASE_URL=http://localhost:7328/employee_management/

# ------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------
WN_DB_HOST=localhost
WN_DB_USERNAME=your_database_username
WN_DB_PASSWORD=your_database_password
WN_DB_DATABASE=employee

# ------------------------------------------------------------
# Encryption Key (generate a random 32+ character string)
# ------------------------------------------------------------
WN_ENCRYPTION_KEY=your_random_encryption_key_here

# ------------------------------------------------------------
# SMTP / Email Configuration
# ------------------------------------------------------------
WN_SMTP_HOST=smtp.gmail.com
WN_SMTP_PORT=587
WN_SMTP_USER=your_email@gmail.com
WN_SMTP_PASS=your_app_password
WN_FROM_EMAIL=your_email@gmail.com

# ------------------------------------------------------------
# Google Calendar API (optional)
# ------------------------------------------------------------
# Place credentials.json and token.json in:
#   application/config/google/
# These files are excluded from version control.
# See README.md for Google OAuth setup instructions.
